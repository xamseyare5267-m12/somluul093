ALLOW_DEV_OTP=
# Netlify build-time public API base URL. Set this to the stable Vercel API URL
# when Netlify is not using the /api proxy redirect.
VITE_API_URL=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
OWNER_PASSWORD=
OWNER_PHONE=
OWNER_USERNAME=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=files-bucket
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
TEXTBELT_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# REQUIRED for production: Supabase Postgres is the authoritative application database.
# Production values must be supplied by your deployment secret manager.
# Do not commit real secrets to Git.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
# CORS_ORIGINS=https://somluul.com,https://www.somluul.com
# OWNER_USERNAME=<owner-username>
# OWNER_EMAIL=<owner-email>
# OWNER_PASSWORD=<long-random-password>
GEMINI_API_KEY=

# =============================================================================
# SCALE MODE (Phase 2 — normalized tables, CDN media, TURN, Redis)
# =============================================================================
# Set SCALE_MODE=1 after running supabase/schema_v2_scale.sql
SCALE_MODE=1

# CORS — comma-separated HTTPS origins only
CORS_ORIGINS=

# CDN in front of object storage (Cloudflare / Fastly / CloudFront)
# Example: https://cdn.somluul.com
CDN_BASE_URL=

# Redis for hot-path cache (Upstash / Redis Cloud / ElastiCache)

# REQUIRED in production; use the Redis URL from your Redis provider.
REDIS_URL=

# TURN servers for real-world WebRTC (voice/video calls behind NAT/mobile)
# Providers: Twilio Network Traversal, Metered.ca, coturn self-host, Xirsys
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_URL_2=

# Phase 7 job/bus
REDIS_REALTIME_CHANNEL=somluul:realtime
REDIS_JOB_QUEUE=somluul:jobs

# Phase 9 ops
OPS_METRICS_TOKEN=

# Phase 10 hyperscale (optional)
SHARD_COUNT=1
# SHARD_0_SUPABASE_URL=
# SHARD_1_SUPABASE_URL=
# SERVICE_CHAT_URL=
# SERVICE_REALTIME_URL=
# SERVICE_MEDIA_URL=
# PUBLIC_API_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIVE_PROVIDER=
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MAX_PARTICIPANTS=10000
OTP_SECRET=
PRODUCTION_PROFILE=basic
REQUIRE_MEDIA_MODERATION=1
MEDIA_MODERATION_WEBHOOK_URL=
MEDIA_MODERATION_WEBHOOK_TOKEN=
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_TOKEN=
WITHDRAWAL_ENCRYPTION_KEY=

# Production live video (LiveKit SFU)
# LIVE_PROVIDER=livekit
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_URL=https://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Strict media moderation
# REQUIRE_MEDIA_MODERATION=1
# GEMINI_API_KEY=
# MEDIA_MODERATION_WEBHOOK_URL=https://your-video-moderation-worker.example/moderate
# MEDIA_MODERATION_WEBHOOK_TOKEN=
